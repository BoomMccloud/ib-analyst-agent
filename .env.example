# Cloudflare Tunnel token from one.dash.cloudflare.com → Networks → Tunnels.
# Created when you run "Create a tunnel"; the dashboard shows it on the install page.
CLOUDFLARE_TUNNEL_TOKEN=eyJhIj...replace_me

# OpenAI-compatible LLM endpoint. Defaults are Groq's free tier.
# Other options:
#   OpenAI:   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
#   Together: LLM_BASE_URL=https://api.together.xyz/v1
#   Ollama:   LLM_BASE_URL=http://host.containers.internal:11434/v1   LLM_API_KEY=ollama
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_replace_me
LLM_MODEL=llama-3.1-70b-versatile

# SEC EDGAR requires a real contact email in the User-Agent. Generic UAs get 403'd.
SEC_CONTACT_EMAIL=you@example.com
